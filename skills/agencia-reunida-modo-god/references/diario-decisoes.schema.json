{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Linha do diário de decisões do Modo GOD",
  "description": "Uma linha JSON por decisão recomendada, gravada em <pasta do cliente>\\diario-decisoes.jsonl. Campos de resultado ficam nulos até a liquidação na data de conferência. O Brier da linha é (probabilidade - acertou)^2, com acertou valendo 1 ou 0.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "description": "<data>-<slug>-<decisao>, por exemplo 2026-10-06-plano-google-ads-D2" },
    "data_decisao": { "type": "string", "description": "AAAA-MM-DD" },
    "cliente": { "type": "string" },
    "corrida": { "type": "string", "description": "pasta da corrida" },
    "modo": { "type": "string", "enum": ["rapido", "padrao", "god"] },
    "decisao": { "type": "string", "description": "id da decisão (D1, D2...)" },
    "pergunta": { "type": "string" },
    "afirmacao_falsificavel": { "type": "string" },
    "opcao_recomendada": { "type": "string" },
    "minoria_vencedora": { "type": "boolean" },
    "rotulo_confianca": { "type": "string", "enum": ["Alta", "Média", "Baixa"] },
    "motivos_rotulo": { "type": "array", "items": { "type": "string" } },
    "metrica": { "type": "string", "description": "o que será medido, com a fonte de onde o número virá (ex.: conversões primárias na conta X via GAQL)" },
    "previsao": { "type": "string" },
    "faixa_min": { "type": "string" },
    "faixa_max": { "type": "string" },
    "probabilidade": { "type": "number", "minimum": 0, "maximum": 1, "description": "probabilidade de atingir o critério de sucesso" },
    "criterio_sucesso": { "type": "string" },
    "criterio_abandono": { "type": "string" },
    "data_conferencia": { "type": "string", "description": "AAAA-MM-DD; D+30, D+60 ou D+90" },
    "go_do_bruno": { "type": ["string", "null"], "description": "GO, NO-GO ou null se ainda não decidido" },
    "resultado_real": { "type": ["string", "null"] },
    "fonte_resultado": { "type": ["string", "null"] },
    "data_liquidacao": { "type": ["string", "null"] },
    "acertou": { "type": ["boolean", "null"] },
    "brier": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "reflexao": { "type": ["string", "null"], "description": "um parágrafo na liquidação: o que o conselho viu e não viu" }
  },
  "required": ["id", "data_decisao", "cliente", "corrida", "modo", "decisao", "pergunta", "opcao_recomendada", "rotulo_confianca", "metrica", "previsao", "probabilidade", "criterio_sucesso", "criterio_abandono", "data_conferencia", "resultado_real", "acertou", "brier"]
}
